# Database
# Leave unset (or use SQLite) for local development.
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@localhost:5432/skilloutcome
# Defaults to backend/skilloutcome.db regardless of the server working directory.
# DATABASE_URL=sqlite:///C:/path/to/skilloutcome/backend/skilloutcome.db

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
